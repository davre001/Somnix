# SOMNIX Environment Configuration
# One Next.js app — the browser talks to the DreamDEX indexer + Somnia RPC
# directly for real trades (locking, claiming, faucet, resolution), and to
# this app's own /api/* route handlers for display data and the best-effort
# lock/claim history mirror.

## Client-accessible (bundled into the browser — no secrets here)

# DreamDEX Hasura indexer. Not a secret — a public GraphQL endpoint. Read by
# both the browser SDK client (lib/exchange.ts) and the server-side display
# proxy (lib/server/dreamdex.ts), so there's one value, not two to keep in sync.
NEXT_PUBLIC_DREAMDEX_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

## Server-only (never sent to the browser)

# Turso (libSQL) — the lock/claim history mirror's database. Without these set,
# lib/server/tursoStore.ts falls back to a local `file:local.db` for dev, which
# will NOT survive a serverless deploy — set both for anything beyond local dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: Hasura role/admin-secret for privileged server-only indexer reads.
DREAMDEX_INDEXER_ADMIN_SECRET=
